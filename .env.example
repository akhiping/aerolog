# AeroLog Configuration
# Copy to .env and fill in values. App runs in LocalSim mode with no keys set.

# Database — defaults to SQLite if not set
DATABASE_URL=sqlite+aiosqlite:///./aerolog.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/aerolog

# Voice provider: local_sim | bolna | plivo | exotel
VOICE_PROVIDER=local_sim

# ASR provider: local_sim | deepgram | sarvam
ASR_PROVIDER=local_sim

# TTS provider: local_sim | cartesia | sarvam
TTS_PROVIDER=local_sim

# LLM provider: rule_based | anthropic | openai
LLM_PROVIDER=rule_based

# API keys (only needed when using real providers)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
CARTESIA_API_KEY=

# Bolna voice agent
BOLNA_API_KEY=
BOLNA_AGENT_ID=

# Telephony
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_PHONE_NUMBER=

# Escalation channel: dashboard | call | sms | webhook
ESCALATION_CHANNEL=dashboard
ESCALATION_WEBHOOK_URL=

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
